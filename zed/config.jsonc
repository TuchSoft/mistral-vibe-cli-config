{
  "agent_servers": {
    //Must install the Mistral Vibe ACP registry
    "mistral-vibe": {
      "type": "registry",
    },
  },
  "agent": {
    "favorite_models": [],
    "play_sound_when_agent_done": true,
    "model_parameters": [],
